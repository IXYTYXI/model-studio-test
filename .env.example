# Prefer npm run setup: it generates a random master key and prompts without echo.
# This example intentionally contains unusable placeholders; never use them as secrets.
MASTER_KEY=replace-with-64-hex-characters-from-a-secure-random-generator
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD='replace-with-your-own-14-to-128-character-password'
PUBLIC_ORIGIN=http://localhost:8080
DATA_DIR=./data
HOST=127.0.0.1
PORT=8080
DEFAULT_DAILY_LIMIT=50
GLOBAL_DAILY_LIMIT=500
ALLOWED_API_HOSTS=
# Optional provider keys. Set real values locally; never commit them.
# In Awesome Deploy, configure secretRefs instead of uploading this file.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# Optional Google Web OAuth login. Keep both unset until real credentials exist.
# Set both together; configuring only one causes startup validation to fail.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Client ID is not secret. In Awesome Deploy put the ID in env and the secret in secretRefs.
# Register PUBLIC_ORIGIN + /api/auth/google/callback as an authorized redirect URI.
# Local: http://localhost:8080/api/auth/google/callback
# Production: https://chatstd.awesome.guanghexinzhi.cn/api/auth/google/callback
# Remove BOOTSTRAP_PASSWORD after the first successful login; preserve MASTER_KEY.
# Secret-file alternatives: MASTER_KEY_FILE and BOOTSTRAP_PASSWORD_FILE.
# These override the matching inline values. Paths must exist inside the process/container.
# Configure PUBLIC_ORIGIN=https://your-domain.example behind an HTTPS reverse proxy.
